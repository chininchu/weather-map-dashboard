extends layout

block content
  .container
    h1 Weather Dashboard
    .search-section
      h2 Enter a City Name
      form#searchForm
        label(for='cityInput') City
        input#cityInput(type='text', placeholder='E.g., New York, London, Tokyo', autocomplete='address-level2', required=true)
        button#searchBtn(type='submit') Search
      .divider
        span or
      button#currentLocationBtn(type='button') Use Current Location
      p#status(role='status', aria-live='polite')
    #map(aria-label='Weather location map')
    #currentWeather(aria-live='polite')
    #forecast
      h2 4-Day Forecast
      .forecast-container

  script(src='https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.js')
  link(href='https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.css', rel='stylesheet')
  script.
    var mapboxToken = !{JSON.stringify(mapboxToken || '')};
  script(src='/javascripts/weather.js')